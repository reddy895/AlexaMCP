# ==============================================================================
# Alexa + MCP Assistant Environment Configuration
# ==============================================================================

# Server settings
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
MCP_PATH=/mcp

# Ollama Local LLM settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_MS=30000
MAX_STEPS=8

# SQLite Storage
DATABASE_PATH=.data/assistant.db

# Workspace & Security
WORKSPACE_ROOT=.
APPROVED_DOCS_DIRS=docs,test-inputs
# Optional Bearer token for remote authentication (leave blank for local dev)
AUTH_TOKEN=
RATE_LIMIT_RPS=50
MAX_CONCURRENT_REQUESTS=10

# Observability
LOG_LEVEL=info

# Voice Mode
DD_MODE=voice
RECORD_SECONDS=6
